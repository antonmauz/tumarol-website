{
  "name": "larylin-website",
  // Worker-Projekt "larylin-website", per Git-Anbindung aus GitHub (main) deployt.
  // Vorerst über die *.workers.dev-URL erreichbar. TODO vor Livegang: Custom Domain
  // larylin.de verbinden und workers_dev wieder auf false setzen (keine indexierbaren Duplikate).
  "workers_dev": true,
  "preview_urls": false,
  // Höchstens das Datum der installierten workerd-Version (node_modules/workerd), sonst warnt der Dev-Server.
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist/client",
    // Kanonische URL-Form der Site ist slash-los (siehe astro.config.mjs):
    // /seite wird direkt aus seite/index.html ausgeliefert, /seite/ wird
    // per Redirect auf /seite gezogen.
    "html_handling": "drop-trailing-slash"
  }
}
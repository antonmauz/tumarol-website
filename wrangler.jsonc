{
  "name": "larylin-website",
  // Worker-Projekt "larylin-website", per Git-Anbindung aus GitHub (main) deployt. Die Seite
  // läuft nur unter der Custom Domain larylin.de (im Cloudflare-Dashboard verbunden);
  // *.workers.dev-URL und Preview-URLs sind aus, damit keine indexierbaren Duplikate entstehen.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist/client",
    // Kanonische URL-Form der Site ist slash-los (siehe astro.config.mjs):
    // /seite wird direkt aus seite/index.html ausgeliefert, /seite/ wird
    // per Redirect auf /seite gezogen.
    "html_handling": "drop-trailing-slash"
  }
}
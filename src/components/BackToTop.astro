---
// „Nach oben"-Band über die volle Seitenbreite (direkt über dem Footer) als fokussierbarer <button>.
// Hintergrund: derselbe warme Verlauf wie das Platzhalter-Headerbild der Magazin-Artikel
// (Gelb → Creme → Apricot); Text in Ink, auf den hellen Tönen gut lesbar. Hover hebt die
// Sättigung leicht an.
---

<div class="w-full">
  <button
    type="button"
    data-back-to-top
    aria-label="Nach oben scrollen"
    class="back-to-top group w-full flex items-center justify-center gap-2.5 py-5 px-6 text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ink/60 cursor-pointer"
  >
    <svg class="w-5 h-5 transition-transform group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
    <span class="text-sm font-semibold uppercase tracking-wide">Nach oben scrollen</span>
  </button>
</div>

<style>
  .back-to-top {
    background: linear-gradient(90deg, #fde79a 0%, #fff4d8 45%, #fde3c0 70%, #fdcb98 100%);
    transition: filter 150ms ease;
  }
  .back-to-top:hover {
    filter: saturate(1.25) brightness(0.98);
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('[data-back-to-top]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    });
  });
</script>

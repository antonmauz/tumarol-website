---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import SliderControls from './SliderControls.astro';
import ArticleTile from './ArticleTile.astro';
import { ratgeberArticleUrl, categoryLabel } from '../data/categories';
import { sortRatgeberArticles } from '../utils/articleSort';
import { readingTimeLabel } from '../data/readingTime';

// Globaler Artikel-Slider: Bild-Kacheln aller Ratgeber-Artikel, seitenweise
// blätterbar, responsiv 1–3 Kacheln. Kachel-Optik zentral in ArticleTile
// (hellgraue Karte, Farbbalken in der Folge Gelb/Orange/Rot, Hover: Bild zoomt).

interface Props {
  heading: string;
  /** Artikel-URL, die NICHT gezeigt wird (z. B. die aktuelle Seite). */
  excludeHref?: string;
  /** Hintergrund/zusätzliche Klassen der <section> (Standard: transparent, also weiß). */
  class?: string;
}

const { heading, excludeHref, class: sectionClass = '' } = Astro.props;

interface SliderItem {
  href: string;
  title: string;
  headerImage?: ImageMetadata;
  headerImageAlt?: string;
  badge?: string;
  readingTime?: string;
}

const ratgeber: SliderItem[] = sortRatgeberArticles(
  await getCollection('ratgeber'),
).map((article) => ({
  href: ratgeberArticleUrl(article.data.category, article.id),
  // Voller Artikel-Header statt breadcrumbLabel: aussagekräftigere Kacheln.
  title: article.data.h1,
  headerImage: article.data.headerImage,
  headerImageAlt: article.data.headerImageAlt ?? article.data.title,
  badge: categoryLabel(article.data.category),
  readingTime: readingTimeLabel(article.body ?? ''),
}));

const items = ratgeber.filter((item) => item.href !== excludeHref);

---

<section class={`py-16 md:py-20 px-6 ${sectionClass}`}>
  <Container size="content">
    <div class="flex items-end justify-between gap-4 mb-8">
      <h2 class="min-w-0 hyphens-auto">{heading}</h2>

      <SliderControls prevLabel="Vorherige Artikel" nextLabel="Weitere Artikel" />
    </div>

    <div data-snap-slider>
      <div
        data-slider-track
        class="flex gap-6 slider-bleed overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 -mb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {/* basis-[85%] wie die Produktkarten: die Folgekarte lugt seitlich rein. */}
        {items.map((item) => (
          <div class="snap-start shrink-0 basis-[85%] md:basis-[calc((100%_-_1.5rem)/2)] lg:basis-[calc((100%_-_3rem)/3)]">
            <ArticleTile
              href={item.href}
              title={item.title}
              image={item.headerImage}
              imageAlt={item.headerImageAlt}
              badge={item.badge}
              readingTime={item.readingTime}
            />
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<script>
  import { initSnapSliders } from '../scripts/snapSlider';
  initSnapSliders();
</script>

---
// TrustBanner.astro – Vertrauensanker über die volle Seitenbreite: Studio-Hintergrund
// (larylin-vertrauensbanner-bg.png, Wand oben, heller Boden ab ~78 % der Bildhöhe),
// links die beiden Packshots auf dem Boden, rechts vier Punkte mit Haken.
// Hintergrund unten verankert (object-bottom), damit der Boden bei jeder Höhe unten
// liegt; der untere Innenabstand stellt die Schachteln auf den Boden. Untere Ecken
// abgerundet (overflow-hidden schneidet das Bild mit ab).
// TODO (LARYLIN): Wortlaut fachlich freigeben lassen (HWG, v. a. „Wirkung direkt in
// Lunge und Bronchien“).
import { Image } from 'astro:assets';
import Container from './Container.astro';
import PackshotGroup from './PackshotGroup.astro';
import background from '../assets/images/backgrounds/larylin-vertrauensbanner-bg.png';

const trustPoints = [
  'Gegen Reizhusten',
  'Gegen Krampfhusten',
  'Wirkung direkt in Lunge und Bronchien',
  'Hergestellt in Deutschland',
];
---

<section class="relative overflow-hidden rounded-b-[1.5rem] md:rounded-b-[2.5rem] px-6 pt-14 pb-10 md:pt-16 lg:pb-[clamp(2.5rem,4vw,4.5rem)]" aria-label="Larylin® auf einen Blick">
  <Image
    src={background}
    alt=""
    widths={[800, 1280, 1916]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-bottom"
  />

  {/* Mobil: Punkte oben, Packshots darunter auf dem Boden; ab md nebeneinander,
      Packshots links unten, Punkte rechts vertikal mittig. */}
  <Container size="content" class="relative grid items-end gap-10 md:grid-cols-2 md:gap-14">
    <div class="order-2 flex justify-center md:order-1">
      <PackshotGroup class="w-[240px] sm:w-[300px] lg:w-[360px]" sizes="(min-width: 1024px) 340px, 280px" />
    </div>

    <ul class="order-1 space-y-5 self-center md:order-2">
      {trustPoints.map((point) => (
        <li class="flex items-center gap-4">
          {/* Haken in Ink auf gelbem Kreis (Markengelb). */}
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-yellow text-ink" aria-hidden="true">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <span class="text-lg font-bold text-ink md:text-xl">{point}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>

---
// Kompakter Listeneintrag neben dem Aufmacher (nach chase.de/blog): kleines quadratisches
// Bild links, rechts Titel und Lesezeit. Ganzer Eintrag = ein Link; Hover zoomt das Bild
// und unterstreicht den Titel gelb.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  readingTime?: string;
}

const { href, title, image, imageAlt, readingTime } = Astro.props;
---

<a href={href} class="group flex items-center gap-4 sm:gap-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink">
  <div class="relative aspect-square w-24 shrink-0 overflow-hidden rounded-card bg-divider sm:w-28">
    {image && (
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[160, 320]}
        sizes="112px"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    )}
  </div>
  <div class="min-w-0">
    <h3 class="text-base leading-snug font-extrabold text-ink sm:text-lg">
      <span class="underline decoration-transparent decoration-[3px] underline-offset-[5px] transition-colors group-hover:decoration-yellow group-focus-visible:decoration-yellow">{title}</span>
    </h3>
    {readingTime && <p class="mt-1.5 text-sm text-neutral-600">{readingTime}</p>}
  </div>
</a>

---
// Artikel-Karte der Übersichten (Wissenswertes, ArticleSlider): hellgraue Karte mit Bild
// oben (Zoom bei Hover), darunter Farbbalken, Kategorie, Titel sowie „Mehr erfahren“ und
// Lesezeit. Ganze Karte = ein Link.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { AccentClass } from '../data/brand';

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Optionales Kategorie-Label über dem Titel. */
  badge?: string;
  /** Optionales Lesezeit-Label, z. B. "3 Min. Lesezeit". */
  readingTime?: string;
  /** Farbe des Kartenbalkens (Folge im Slider über accentAt); Standard Gelb. */
  accent?: AccentClass;
}

const { href, title, image, imageAlt, badge, readingTime, accent = 'bg-yellow' } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-card bg-surface focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ink"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-divider">
    {image ? (
      <Image
        src={image}
        alt={imageAlt ?? title}
        width={640}
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center text-neutral-500">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <span class={`accent-bar mb-4 ${accent}`} aria-hidden="true"></span>
    {badge && <span class="mb-1 text-sm font-semibold text-neutral-600">{badge}</span>}
    {/* text-lg statt h3-Standardgröße: es steht der volle Artikel-Header (h1) in der
        Karte, der braucht 2–3 Zeilen Platz. */}
    <h3 class="text-lg leading-snug font-extrabold text-ink">{title}</h3>

    {/* mt-auto: Fußzeile sitzt bei unterschiedlich langen Titeln auf gleicher Höhe. */}
    <div class="mt-auto flex items-center justify-between gap-3 pt-4">
      <span class="inline-flex items-center gap-1 text-sm font-bold text-ink">
        <span class="underline underline-offset-4 decoration-2 group-hover:decoration-yellow">Mehr erfahren</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
      {readingTime && (
        <span class="inline-flex items-center gap-1 shrink-0 text-sm text-neutral-600">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime}
        </span>
      )}
    </div>
  </div>
</a>

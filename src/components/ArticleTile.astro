---
// Bild-Kachel der Artikel-Übersichten (Wissenswertes, ArticleSlider): vollflächiges
// Bild, Titel unten im Bild; bei Hover/Fokus klappen „Mehr erfahren" und Lesezeit
// aus, auf Touch-Geräten sind sie dauerhaft sichtbar.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Optionale Pill oben links (z. B. Kategorie-Label). */
  badge?: string;
  /** Optionales Lesezeit-Label, z. B. "3 Min. Lesezeit". */
  readingTime?: string;
}

const { href, title, image, imageAlt, badge, readingTime } = Astro.props;
---

<a
  href={href}
  class="group relative block overflow-hidden rounded-lg aspect-[4/3] bg-neutral-200"
>
  {image ? (
    <Image
      src={image}
      alt={imageAlt ?? title}
      width={640}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  ) : (
    <div class="absolute inset-0 flex items-center justify-center text-neutral-400">
      <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
  )}

  {/* Dezenter Themen-Tag oben links */}
  {badge && (
    <span class="absolute top-3 left-3 z-10 inline-flex items-center rounded-full bg-white/90 backdrop-blur-sm px-2.5 py-1 text-sm font-semibold text-neutral-700 shadow-sm">
      {badge}
    </span>
  )}

  {/* Verlauf für die Lesbarkeit des Titels */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>

  {/* Unten verankert; beim Hover fährt der Titel hoch und "Mehr erfahren" ein.
      text-lg statt h3-Standardgröße: es steht der volle Artikel-Header (h1)
      in der Kachel, der braucht 2–3 Zeilen Platz. */}
  <div class="absolute inset-x-0 bottom-0 p-5">
    <h3 class="text-lg leading-snug text-white drop-shadow-sm">
      {title}
    </h3>
    <div class="grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out group-hover:grid-rows-[1fr] group-hover:opacity-100 group-hover:mt-2 group-focus-visible:grid-rows-[1fr] group-focus-visible:opacity-100 group-focus-visible:mt-2 [@media(hover:none)]:grid-rows-[1fr] [@media(hover:none)]:opacity-100 [@media(hover:none)]:mt-2">
      <div class="overflow-hidden">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-1 text-sm font-bold text-white">
            Mehr erfahren
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
          {readingTime && (
            <span class="inline-flex items-center gap-1 shrink-0 rounded-full bg-white/20 backdrop-blur-sm px-2.5 py-1 text-sm font-semibold text-white">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {readingTime}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>
</a>

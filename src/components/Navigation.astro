---
import LarylinLogo from './LarylinLogo.astro';
import Container from './Container.astro';
import { categoryClusters } from '../data/categories';
import { normalizePathname } from '../utils/urls';

interface NavLink {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href?: string;
  dropdown?: NavLink[];
}

// Produkt-Dropdown: die zwei Produktseiten.
const productLinks: NavLink[] = [
  { label: 'Larylin® Husten-Stiller Pastillen', href: '/larylin-pastillen' },
  { label: 'Larylin® Husten-Stiller Saft', href: '/larylin-saft' },
];

// Themen-Cluster als Dropdown; Anker-IDs auf /wissenswertes = Kategorie-Slug.
const wissenswertesLinks: NavLink[] = categoryClusters.map((c) => ({
  label: c.heading,
  href: `/wissenswertes#${c.category}`,
}));

// Reihenfolge: Produkte, die Wissensseite /husten (Grundlagen und Ursachen), dann
// Wissenswertes (Ratgeber, Slug /wissenswertes festgelegt 02.09.2026).
const navLinks: NavItem[] = [
  { label: 'Produkte', dropdown: productLinks },
  { label: 'Husten', href: '/husten' },
  { label: 'Wissenswertes', href: '/wissenswertes', dropdown: wissenswertesLinks },
];

// Slash-lose Form wie die href-Werte oben — sonst greift die Aktiv-Markierung im Build nie.
const currentPath = normalizePathname(Astro.url.pathname);

// Aktiv, wenn die Seite der Eintrag selbst ist oder eines seiner Dropdown-Ziele
// (Produktseiten markieren „Produkte“, Artikel unter /wissenswertes/… markieren
// „Wissenswertes“). Anker-Teile der Dropdown-Links werden ignoriert.
const isActive = (link: NavItem): boolean => {
  if (link.href && (currentPath === link.href || currentPath.startsWith(link.href + '/'))) return true;
  return (link.dropdown ?? []).some((item) => currentPath === item.href.split('#')[0]);
};

// Dropdown-IDs für aria-controls (ein Eintrag je Dropdown).
const dropdownId = (link: NavItem) => `nav-dropdown-${link.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;


// Navbar-Konzept: sticky weißer Balken über die volle Breite (unter einer optionalen
// TopBar, die beim Scrollen herausläuft); beim Scrollen oder
// offenem Mobile-Menü setzt das Script `data-scrolled`, dann erscheint unten eine
// Trennlinie. Position und Breite ändern sich nie.
const linkBase = 'text-base font-semibold transition-colors text-ink hover:text-black';
// Aktiv-Markierung als dicker gelber Unterstrich (Logo-Motiv) — Farbe allein reicht nicht.
const linkActive = 'underline decoration-yellow decoration-[3px] underline-offset-[6px]';
---

<header
  id="site-header"
  class="group sticky top-0 z-50"
>
  {/* Der Balken: fest oben, volle Breite, immer weiß; beim Scrollen kommt nur eine
      1px-Trennlinie dazu (Farbwechsel, keine Bewegung). */}
  <div class="w-full bg-white border-b border-transparent transition-colors duration-300 group-data-[scrolled]:border-divider">
  <Container size="wide" class="px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16" aria-label="Hauptnavigation">

      {/* Logo */}
      <a href="/" class="flex items-center" aria-label="Larylin – zur Startseite">
        <LarylinLogo />
      </a>

      {/* Desktop Nav */}
      <ul class="hidden md:flex items-center gap-6 lg:gap-8">
        {navLinks.map((link) => (
          <li class="relative group/item" data-nav-dropdown>
            {link.dropdown ? (
              <>
                {link.href ? (
                  /* Label ist ein echter Link, zeigt das Dropdown bei Hover/Fokus. */
                  <a
                    href={link.href}
                    class={`flex items-center gap-1 py-2 ${linkBase} ${isActive(link) ? linkActive : ''}`}
                  >
                    {link.label}
                    <svg class="w-4 h-4 transition-transform group-hover/item:rotate-180 group-focus-within/item:rotate-180 group-data-[open]/item:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>
                ) : (
                  /* Ohne eigene Seite: Button öffnet das Dropdown per Klick/Tap (Touch-
                     Geräte ab md haben kein Hover) — Zustand über aria-expanded + data-open. */
                  <button
                    type="button"
                    class={`flex items-center gap-1 py-2 cursor-pointer ${linkBase} ${isActive(link) ? linkActive : ''}`}
                    aria-expanded="false"
                    aria-controls={dropdownId(link)}
                    data-nav-dropdown-toggle
                  >
                    {link.label}
                    <svg class="w-4 h-4 transition-transform group-hover/item:rotate-180 group-focus-within/item:rotate-180 group-data-[open]/item:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                )}
                <div
                  id={dropdownId(link)}
                  class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-64 bg-white rounded-card shadow-xl border border-divider opacity-0 invisible group-hover/item:opacity-100 group-hover/item:visible group-focus-within/item:opacity-100 group-focus-within/item:visible group-data-[open]/item:opacity-100 group-data-[open]/item:visible transition-all duration-200 origin-top scale-95 group-hover/item:scale-100 group-focus-within/item:scale-100 group-data-[open]/item:scale-100"
                >
                  <div class="py-2">
                    {link.dropdown.map((item) => (
                      <a
                        href={item.href}
                        class="block py-2.5 px-4 text-base font-medium text-ink hover:bg-surface transition-colors"
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a
                href={link.href}
                class={`${linkBase} ${isActive(link) ? linkActive : ''}`}
              >
                {link.label}
              </a>
            )}
          </li>
        ))}
      </ul>

      {/* Rechts: Kauf-CTA */}
      <div class="hidden md:flex items-center gap-4">
        <button
          type="button"
          data-open-pharmacy-drawer
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-pill bg-red text-white text-base font-bold hover:bg-red-dark transition-colors cursor-pointer"
        >
          Jetzt kaufen
        </button>
      </div>

      {/* Mobile: Kauf-Button (Warenkorb) + Menü-Button */}
      <div class="flex md:hidden items-center gap-2">
        <button
          type="button"
          data-open-pharmacy-drawer
          class="p-2.5 rounded-pill bg-red text-white hover:bg-red-dark transition-colors cursor-pointer"
          aria-label="Jetzt kaufen"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </button>
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-pill text-ink hover:bg-surface transition-colors cursor-pointer"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          {/* Zwei Icons, per JS umgeschaltet: Hamburger (zu) / Kreuz (offen) */}
          <svg data-icon-menu class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg data-icon-close class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </nav>
  </Container>

  {/* Mobile Menu: flache Liste mit zwei Akkordeons; absolut unter dem Balken, damit es
      den Seiteninhalt der sticky Navbar nicht nach unten schiebt. */}
  <div id="mobile-menu" class="hidden md:hidden absolute inset-x-0 top-full border-t border-b border-divider bg-white max-h-[calc(100vh-5rem)] overflow-y-auto">
    <Container size="wide" class="px-6 py-2">
      <nav class="divide-y divide-divider" aria-label="Mobile Navigation">

        {/* Produkte (Akkordeon) */}
        <details class="group/acc">
          <summary class="flex items-center justify-between gap-4 py-3.5 font-semibold text-neutral-900 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Produkte
            <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open/acc:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pb-3">
            {productLinks.map((item) => (
              <a
                href={item.href}
                class="block py-2 text-base font-medium text-neutral-700 hover:text-primary"
              >
                {item.label}
              </a>
            ))}
          </div>
        </details>

        {/* Husten (Wissensseite) */}
        <a href="/husten" class="block py-3.5 font-semibold text-neutral-900 hover:text-primary">
          Husten
        </a>

        {/* Wissenswertes (Akkordeon) */}
        <details class="group/acc">
          <summary class="flex items-center justify-between gap-4 py-3.5 font-semibold text-neutral-900 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Wissenswertes
            <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open/acc:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pb-3">
            <a href="/wissenswertes" class="block py-2 text-base font-medium text-neutral-700 hover:text-primary">
              Alle Themen ansehen
            </a>
            {wissenswertesLinks.map((item) => (
              <a href={item.href} class="block py-2 pl-4 text-base text-neutral-600 hover:text-primary">
                {item.label}
              </a>
            ))}
          </div>
        </details>

        {/* CTA Button */}
        <div class="py-4">
          <button type="button" data-open-pharmacy-drawer class="w-full text-center py-3 rounded-pill bg-red text-white text-base font-bold hover:bg-red-dark transition-colors cursor-pointer">
            Jetzt kaufen
          </button>
        </div>

      </nav>
    </Container>
  </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  // Navbar bleibt fest an ihrer Stelle; beim Scrollen (oder bei offenem Mobile-Menü)
  // bekommt sie nur eine Trennlinie nach unten.
  const updateHeader = () => {
    const menuOpen = menu ? !menu.classList.contains('hidden') : false;
    const solid = menuOpen || window.scrollY > 16;
    header?.toggleAttribute('data-scrolled', solid);
  };

  const iconMenu = btn?.querySelector('[data-icon-menu]');
  const iconClose = btn?.querySelector('[data-icon-close]');

  const setMenuOpen = (isOpen: boolean) => {
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    btn?.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
    // Hamburger ↔ Kreuz: signalisiert, dass derselbe Button wieder schließt
    iconMenu?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    updateHeader();
  };

  btn?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Menü bei jedem Klick auf Link oder Kauf-Button schließen (Same-Page-Anker navigieren
  // nicht neu). Capture-Phase, damit der Fokus schon auf dem Menü-Button liegt, bevor der
  // Drawer sich das aktive Element merkt: so kommt der Fokus beim Schließen dorthin zurück.
  menu?.querySelectorAll('a[href], [data-open-pharmacy-drawer]').forEach((link) => {
    link.addEventListener(
      'click',
      () => {
        if (link.hasAttribute('data-open-pharmacy-drawer')) btn?.focus();
        setMenuOpen(false);
      },
      { capture: true },
    );
  });

  // Desktop-Dropdown ohne eigene Seite („Produkte“): Klick/Tap toggelt, Escape
  // und Klick außerhalb schließen; Hover/Fokus bleiben rein per CSS.
  const dropdownItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));
  const setDropdownOpen = (item: HTMLElement, open: boolean) => {
    item.toggleAttribute('data-open', open);
    item.querySelector('[data-nav-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  const closeAllDropdowns = () => dropdownItems.forEach((item) => setDropdownOpen(item, false));
  dropdownItems.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]');
    toggle?.addEventListener('click', () => {
      const open = !item.hasAttribute('data-open');
      closeAllDropdowns();
      setDropdownOpen(item, open);
    });
  });
  document.addEventListener('click', (e) => {
    if (!dropdownItems.some((item) => item.contains(e.target as Node))) closeAllDropdowns();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openItem = dropdownItems.find((item) => item.hasAttribute('data-open'));
    if (!openItem) return;
    closeAllDropdowns();
    openItem.querySelector<HTMLElement>('[data-nav-dropdown-toggle]')?.focus();
  });

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>

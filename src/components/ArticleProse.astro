---
// Einheitlicher Wrapper + Styling für aus Markdown gerenderten Artikeltext
// (RatgeberArticle); Ersatz für das nicht installierte @tailwindcss/typography.

interface Props {
  /** Zusätzliche Klassen des Wrappers (z. B. max-w-3xl zur Zeilenlängen-Begrenzung). */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`article-prose ${className}`.trim()}>
  <slot />
</div>

<style is:global>
  .article-prose > :first-child { margin-top: 0; }
  /* Überschriften-Größen/Gewichte kommen aus global.css – hier nur Farbe und Abstände.
     scroll-margin-top: Anker-Sprünge landen unterhalb der fixierten Navbar. */
  .article-prose h2 {
    color: var(--color-neutral-900);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    scroll-margin-top: 6rem;
  }
  .article-prose h3 {
    color: var(--color-neutral-900);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 6rem;
  }
  /* Bilder im Artikeltext (z. B. Infografik-SVGs): volle Textbreite, abgerundet. */
  .article-prose img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 0.25rem);
    margin: 2rem auto;
  }

  .article-prose p {
    color: var(--color-neutral-700);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .article-prose strong { font-weight: 700; color: var(--color-neutral-900); }
  .article-prose a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .article-prose a:hover { color: var(--color-primary-dark); }
  .article-prose ul {
    list-style: none;
    margin: 0 0 1.5rem 0;
    padding: 0;
  }
  .article-prose ul li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--color-neutral-700);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  .article-prose ul li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }
  /* Nummerierte Listen: Preflight entfernt list-style — hier wieder setzen. */
  .article-prose ol {
    list-style: decimal;
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
  }
  .article-prose ol li {
    color: var(--color-neutral-700);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .article-prose blockquote {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }
  .article-prose blockquote p { color: var(--color-neutral-800); margin-bottom: 0; }

  /* Markdown-Tabellen (GFM): volle Textbreite, Kopfzeile auf Hellgrau,
     1px-Trennlinien zwischen den Zeilen; erste Spalte als Zeilenbeschriftung. */
  .article-prose table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .article-prose th,
  .article-prose td {
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-divider);
  }
  .article-prose thead th {
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 700;
    border-bottom: 2px solid var(--color-ink);
  }
  .article-prose td { color: var(--color-neutral-700); }
  .article-prose td:first-child { color: var(--color-ink); white-space: nowrap; }
  @media (max-width: 639px) {
    .article-prose table { font-size: 0.875rem; }
    .article-prose th,
    .article-prose td { padding: 0.625rem 0.5rem; }
    .article-prose td:first-child { white-space: normal; hyphens: auto; }
  }
</style>

---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import robugenLogo from '../assets/images/logo/Robugen_Logo_noBg.png';
import korodinLogo from '../assets/images/social/korodin-hkt-logo.png';
import antihydralLogo from '../assets/images/social/antihydral-logo.png';
import type { PharmacyProduct } from '../data/pharmacies';
import { COMPANY_NAME, COMPANY_URL, COMPANY_LINKEDIN_URL } from '../data/company';
import { pflichtangaben, pflichtangabenSchluss, pflichtangabenHersteller } from '../data/pflichtangaben';

const infoLinks: { label: string; href: string; external?: boolean }[] = [
  { label: 'Über uns', href: COMPANY_URL, external: true },
];

interface Props {
  /** Produkt der aktuellen Seite (aus Layout); die REPAIR CREME ist ein Kosmetikum. */
  product?: PharmacyProduct;
}
const { product } = Astro.props;
const herstellerZeile = product === 'repair' ? 'Ein Kosmetikum von' : 'Ein Arzneimittel von';

const legalLinks = [
  { label: 'Pflichtangaben', href: '/pflichtangaben' },
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
  { label: 'Nutzung von KI', href: '/nutzung-von-ki' },
];
---

{/* Zwei Karten in Balkenbreite (bar-w/max-w-bar): oben die graue Hauptkarte mit Logos,
    Links und Pflichttext, darunter die dunkelblaue Legal-Karte mit Copyright und
    Rechtslinks (weiße Schrift auf Blau ist zulässig). */}
<footer class="text-ink">
  <div class="bar-w max-w-bar mx-auto my-3 space-y-3">

  {/* Karte 1: Hauptbereich (grau). */}
  <div class="rounded-xl bg-neutral-100">
  <Container size="wide" class="px-6 lg:px-8 py-16">
    {/* 4-Spalten-Raster ab md (Spalte 2 bleibt als Abstand leer); mobil gestapelt. */}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      {/* Brand: mobil steht der Herstellerhinweis neben dem Logo, ab md darunter */}
      <div class="md:col-start-1 flex items-center gap-4 md:block">
        <a href={COMPANY_URL} target="_blank" rel="noopener noreferrer" class="inline-block shrink-0 md:mb-4" aria-label={`${COMPANY_NAME} (öffnet in neuem Tab)`}>
          <Image
            src={robugenLogo}
            alt={COMPANY_NAME}
            height={128}
            loading="lazy"
            class="h-16 w-auto"
          />
        </a>
        <p class="text-sm font-medium text-neutral-700">{herstellerZeile}<br />{COMPANY_NAME}</p>
      </div>

      {/* Weitere Arzneimittel (ab md Spalte 3); Logos kleiner als das Robugen-Logo,
          wegen unterschiedlicher Proportionen mit eigener Höhe je Logo. */}
      <div class="md:col-start-3">
        <h3 class="text-sm font-semibold text-neutral-700 mb-4">Weitere Arzneimittel</h3>
        <ul class="space-y-5">
          <li>
            <a
              href="https://www.korodin.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block"
              aria-label="KORODIN Herz-Kreislauf-Tropfen (öffnet in neuem Tab)"
            >
              <Image
                src={korodinLogo}
                alt="KORODIN Herz-Kreislauf-Tropfen"
                height={112}
                loading="lazy"
                class="h-14 w-auto"
              />
            </a>
          </li>
          <li>
            <a
              href="https://www.antihydral.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block"
              aria-label="Antihydral Salbe (öffnet in neuem Tab)"
            >
              <Image
                src={antihydralLogo}
                alt="Antihydral Salbe"
                height={56}
                loading="lazy"
                class="h-7 w-auto"
              />
            </a>
          </li>
        </ul>
      </div>

      {/* Info (ab md in Spalte 4) */}
      <div class="md:col-start-4">
        <h3 class="text-sm font-semibold text-neutral-700 mb-4">Informationen</h3>
        <ul class="space-y-3">
          {infoLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-600 hover:text-primary transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${link.label} (öffnet in neuem Tab)` } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        {/* LinkedIn-Button (Robugen-Unternehmensseite) */}
        <a
          href={COMPANY_LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-neutral-600 hover:text-primary transition-colors"
          aria-label="Robugen auf LinkedIn (öffnet in neuem Tab)"
        >
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 9.67H5.67V18h2.67V9.67zM7 6.33a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1zM18.33 18v-4.57c0-2.45-1.31-3.59-3.05-3.59a2.63 2.63 0 0 0-2.38 1.31V9.67h-2.67V18h2.67v-4.4c0-1.16.22-2.28 1.66-2.28 1.41 0 1.43 1.32 1.43 2.35V18h2.67z" />
          </svg>
          LinkedIn
        </a>
      </div>

    </div>
  </Container>

  {/* Pflichtangaben nach § 4 HWG für die zwei Arzneimittel (Name, Wirkstoff,
      Anwendungsgebiete, Warnhinweis), Wortlaut zentral in src/data/pflichtangaben.ts;
      die REPAIR CREME ist ein Kosmetikum ohne Pflichttext. */}
  <div>
    <Container size="wide" class="px-6 lg:px-8 pb-6 space-y-2">
      {pflichtangaben.map((product) => (
        <p class="text-xs text-ink leading-relaxed">
          <strong>{product.name}.</strong> Wirkstoff: {product.kurz.wirkstoff}. Anwendungsgebiete: {product.kurz.anwendungsgebiete} Warnhinweis: {product.kurz.warnhinweis}
        </p>
      ))}
      <p class="text-xs text-ink leading-relaxed">
        {pflichtangabenSchluss} {pflichtangabenHersteller}
      </p>
    </Container>
  </div>

  </div>

  {/* Karte 2: Legal-Bereich (Dunkelblau, weiße Schrift) */}
  <div class="rounded-xl bg-primary text-white">
    <Container size="wide" class="px-6 lg:px-8 py-6">

      {/* Legal Bar */}
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <p class="text-sm text-white/80">
          {/* Jahr wird zur Build-Zeit eingesetzt (statische Site) — Rebuild zum Jahreswechsel. */}
          Copyright © {new Date().getFullYear()} {COMPANY_NAME}
        </p>
        <ul class="flex flex-wrap gap-4">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/80 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </Container>
  </div>

  </div>
</footer>


---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import LarylinLogo from './LarylinLogo.astro';
import robugenLogo from '../assets/images/logo/Robugen_Logo_noBg.png';
import korodinLogo from '../assets/images/social/korodin-hkt-logo.png';
import antihydralLogo from '../assets/images/social/antihydral-logo.png';
import { COMPANY_NAME, COMPANY_URL, COMPANY_LINKEDIN_URL } from '../data/company';
import { pflichtangaben, pflichtangabenSchluss, pflichtangabenHersteller } from '../data/pflichtangaben';

const infoLinks: { label: string; href: string; external?: boolean }[] = [
  { label: 'Über uns', href: COMPANY_URL, external: true },
];

const herstellerZeile = 'Ein Arzneimittel von';

const legalLinks = [
  { label: 'Pflichtangaben', href: '/pflichtangaben' },
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
  { label: 'Nutzung von KI', href: '/nutzung-von-ki' },
];
---

{/* Dunkle Fläche (#111111) in voller Breite: Logo, Hersteller, Links, darunter der
    Pflichttext und die Legal-Zeile. Fremdlogos liegen auf weißen Kacheln, damit ihre
    Originalfarben auf dem dunklen Grund lesbar bleiben. */}
<footer class="bg-ink text-white">
  <Container size="wide" class="px-6 lg:px-8 pt-16 pb-10">
    {/* 4-Spalten-Raster ab md (Spalte 2 bleibt als Abstand leer); mobil gestapelt. */}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      {/* Marke + Hersteller */}
      <div class="md:col-start-1 space-y-5">
        <a href="/" class="inline-flex" aria-label="Larylin – zur Startseite">
          <LarylinLogo tone="light" />
        </a>
        <div class="flex items-center gap-4">
          <a href={COMPANY_URL} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 rounded-card bg-white p-3" aria-label={`${COMPANY_NAME} (öffnet in neuem Tab)`}>
            <Image
              src={robugenLogo}
              alt={COMPANY_NAME}
              height={96}
              loading="lazy"
              class="h-10 w-auto"
            />
          </a>
          <p class="text-sm font-medium text-white/80">{herstellerZeile}<br />{COMPANY_NAME}</p>
        </div>
      </div>

      {/* Weitere Arzneimittel (ab md Spalte 3); Logos mit eigener Höhe je Proportion. */}
      <div class="md:col-start-3">
        <h3 class="text-sm font-bold text-white mb-4">Weitere Arzneimittel</h3>
        <ul class="flex flex-wrap gap-3 md:flex-col md:items-start">
          <li>
            <a
              href="https://www.korodin.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-card bg-white px-4 py-2"
              aria-label="KORODIN Herz-Kreislauf-Tropfen (öffnet in neuem Tab)"
            >
              <Image
                src={korodinLogo}
                alt="KORODIN Herz-Kreislauf-Tropfen"
                height={96}
                loading="lazy"
                class="h-12 w-auto"
              />
            </a>
          </li>
          <li>
            <a
              href="https://www.antihydral.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-card bg-white px-4 py-3"
              aria-label="Antihydral Salbe (öffnet in neuem Tab)"
            >
              <Image
                src={antihydralLogo}
                alt="Antihydral Salbe"
                height={56}
                loading="lazy"
                class="h-7 w-auto"
              />
            </a>
          </li>
        </ul>
      </div>

      {/* Info (ab md in Spalte 4) */}
      <div class="md:col-start-4">
        <h3 class="text-sm font-bold text-white mb-4">Informationen</h3>
        <ul class="space-y-3">
          {infoLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/80 hover:text-white hover:underline underline-offset-4 transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${link.label} (öffnet in neuem Tab)` } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        {/* LinkedIn-Button (Robugen-Unternehmensseite) */}
        <a
          href={COMPANY_LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white/80 hover:text-white transition-colors"
          aria-label="Robugen auf LinkedIn (öffnet in neuem Tab)"
        >
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 9.67H5.67V18h2.67V9.67zM7 6.33a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1zM18.33 18v-4.57c0-2.45-1.31-3.59-3.05-3.59a2.63 2.63 0 0 0-2.38 1.31V9.67h-2.67V18h2.67v-4.4c0-1.16.22-2.28 1.66-2.28 1.41 0 1.43 1.32 1.43 2.35V18h2.67z" />
          </svg>
          LinkedIn
        </a>
      </div>

    </div>

    {/* Pflichtangaben nach § 4 HWG für die zwei Arzneimittel (Name, Wirkstoff,
        Anwendungsgebiete, Warnhinweis), Wortlaut zentral in src/data/pflichtangaben.ts;
        TODO (LARYLIN): Liste ist leer, bis die Pflichtangaben eingetragen sind. */}
    <div class="mt-12 pt-8 border-t border-white/15 space-y-2">
      {pflichtangaben.map((product) => (
        <p class="text-xs text-white/80 leading-relaxed">
          <strong class="text-white">{product.name}.</strong> Wirkstoff: {product.kurz.wirkstoff}. Anwendungsgebiete: {product.kurz.anwendungsgebiete} Warnhinweis: {product.kurz.warnhinweis}
        </p>
      ))}
      <p class="text-xs text-white/80 leading-relaxed">
        {pflichtangabenSchluss} {pflichtangabenHersteller}
      </p>
    </div>

    {/* Legal-Zeile */}
    <div class="mt-8 pt-6 border-t border-white/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-sm text-white/70">
        {/* Jahr wird zur Build-Zeit eingesetzt (statische Site) — Rebuild zum Jahreswechsel. */}
        Copyright © {new Date().getFullYear()} {COMPANY_NAME}
      </p>
      <ul class="flex flex-wrap gap-4">
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-white/80 hover:text-white hover:underline underline-offset-4 transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>

---
// Pfeil-Paar für die scroll-snap-Slider (Mechanik: src/scripts/snapSlider.ts).
// Startet unsichtbar (hidden) und wird vom Skript eingeblendet, sobald der
// Track scrollbar ist; das Skript deaktiviert die Pfeile am Anfang/Ende.
interface Props {
  /** aria-label des Zurück-Pfeils, z. B. "Vorherige Artikel". */
  prevLabel: string;
  /** aria-label des Weiter-Pfeils, z. B. "Weitere Artikel". */
  nextLabel: string;
  class?: string;
}

const { prevLabel, nextLabel, class: extra = '' } = Astro.props;

const buttonClass =
  'flex items-center justify-center w-11 h-11 rounded-pill border-2 border-ink bg-white text-ink hover:bg-ink hover:text-white transition-colors disabled:opacity-40 disabled:pointer-events-none cursor-pointer';
---

<div class:list={['hidden items-center gap-2 shrink-0', extra]} data-slider-controls>
  <button type="button" data-slider-prev aria-label={prevLabel} class={buttonClass}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button type="button" data-slider-next aria-label={nextLabel} class={buttonClass}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

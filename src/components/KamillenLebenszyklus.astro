---
// Prozess-Modul „Vom Feld in die Flasche" (Kamillenanbau-Seite): fünf nummerierte
// Stationen als Bilder-Slider, ab md zwei Karten je Seite. Daten in
// src/data/kamillenLebenszyklus.ts; text darf HTML enthalten (Fußnoten) und läuft über set:html.
import { Image } from 'astro:assets';
import Container from './Container.astro';
import SliderControls from './SliderControls.astro';
import { lebenszyklusSteps as steps } from '../data/kamillenLebenszyklus';

interface Props {
  id?: string;
  class?: string;
}

const { id, class: sectionClass = '' } = Astro.props;

const heading = 'Vom Feld in die Flasche';

---

{steps.length > 0 && (
<section id={id} class={`py-16 md:py-20 px-6 scroll-mt-24 ${sectionClass}`}>
  <Container size="content">
    <div class="flex items-end justify-between gap-4 mb-8">
      <h2 class="hyphens-auto min-w-0">{heading}</h2>

      <SliderControls prevLabel="Vorherige Stationen" nextLabel="Weitere Stationen" />
    </div>

    <div data-snap-slider>
      {/* Mobil ~72 % Kartenbreite (Folgekarte lugt rein), ab md 2 Karten (gap-6 = 1.5rem).
          Karten `relative`, damit der absolut positionierte sr-only-Text im Track bleibt
          und nicht die Seitenbreite aufzieht. */}
      <ol
        data-slider-track
        class="flex gap-6 slider-bleed overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 -mb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {steps.map((step, index) => (
          <li class="relative snap-start shrink-0 basis-[72%] md:basis-[calc((100%_-_1.5rem)/2)]">
            <div class="h-full flex flex-col">
              {/* Bildfläche 4:3 mit Nummern-Plakette; ohne Bild neutrale Fläche mit Hinweis. */}
              <div class="relative">
                {step.image ? (
                  <Image
                    src={step.image}
                    alt={step.imageAlt ?? step.title}
                    width={1088}
                    loading="lazy"
                    class="block w-full aspect-[4/3] object-cover rounded-xl"
                  />
                ) : (
                  <div class="flex items-center justify-center w-full aspect-[4/3] rounded-xl bg-neutral-100 text-sm text-neutral-500" aria-hidden="true">
                    Bild folgt
                  </div>
                )}
                <span
                  class="absolute top-3 left-3 flex items-center justify-center w-9 h-9 rounded-full bg-brand text-blue font-semibold text-base tabular-nums"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
              </div>
              <div class="pt-4 md:pt-5">
                <h3 class="text-blue text-lg mb-1.5">
                  <span class="sr-only">Station {index + 1}: </span>{step.title}
                </h3>
                {/* set:html wegen der Fußnoten-<sup> (GACP/GMP, src/data/hinweise.ts). */}
                <p class="text-neutral-700 leading-relaxed" set:html={step.text} />
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
)}

<script>
  import { initSnapSliders } from '../scripts/snapSlider';
  initSnapSliders();
</script>

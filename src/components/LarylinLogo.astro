---
// Markenlogo als Bild aus src/assets/images/logo/TUMAROL600x300.png (transparent, 601 × 300).
// TODO (TUMAROL): Übergangslösung — Komponente noch unter altem Namen, Alt-Text prüfen. Höhe über `class` anpassbar (Standard h-12).
import { Image } from 'astro:assets';
import logo from '../assets/images/logo/TUMAROL600x300.png';

interface Props {
  class?: string;
}

const { class: extra = 'h-12' } = Astro.props;
---

<Image
  src={logo}
  alt="Tumarol®"
  densities={[1, 2, 3]}
  height={48}
  loading="eager"
  class:list={['w-auto', extra]}
/>

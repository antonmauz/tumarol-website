---
// Larylin-Logo (Wort-Bild-Marke „Larylin® Husten-Stiller“) als Bild aus
// src/assets/images/logo/larylin-logo.png (transparent, 599 × 173). Nur für hellen Grund;
// eine weiße Variante gibt es noch nicht. Höhe über `class` anpassbar (Standard h-12).
import { Image } from 'astro:assets';
import logo from '../assets/images/logo/larylin-logo.png';

interface Props {
  class?: string;
}

const { class: extra = 'h-12' } = Astro.props;
---

<Image
  src={logo}
  alt="Larylin® Husten-Stiller"
  densities={[1, 2, 3]}
  height={48}
  loading="eager"
  class:list={['w-auto', extra]}
/>

---
// DownloadsSection.astro — Download-Karten (PDF) der Produktseiten.
// Daten je Präparat in src/data/downloads.ts; Dateien unter public/downloads/.
import Container from './Container.astro';
import { downloadsFor } from '../data/downloads';
import type { PharmacyProduct } from '../data/pharmacies';

interface Props {
  product: PharmacyProduct;
  heading?: string;
  id?: string;
  class?: string;
}

const { product, heading = 'Downloads', id, class: sectionClass = '' } = Astro.props;
const items = downloadsFor(product);
---

{items.length > 0 && (
<section id={id} class={`py-16 md:py-20 px-6 scroll-mt-24 ${sectionClass}`}>
  <Container size="content">
    <h2 class="mb-8">{heading}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {items.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${item.label}${item.type ? ` (${item.type})` : ''} – öffnet in neuem Tab`}
          class="group flex items-start gap-4 rounded-xl bg-white ring-2 ring-inset ring-blue p-5 transition-colors hover:bg-neutral-50"
        >
          {/* Dokument-Icon in der Leitfarbe */}
          <svg class="w-8 h-8 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5M9 13h6M9 17h6" />
          </svg>
          <span class="min-w-0">
            <span class="block font-semibold text-neutral-900 group-hover:text-primary transition-colors">
              {item.label}
              {item.type && <span class="ml-2 align-middle inline-block rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-semibold text-neutral-600">{item.type}</span>}
            </span>
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>
)}

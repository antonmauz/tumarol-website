---
// Produktkarten-Slider im scroll-snap-Container (Mechanik wie ArticleSlider/ReviewSlider).
// Weitere Karten: Objekt in `products` ergänzen; Namen kommen aus pharmacies.ts.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { pharmacyProducts, type PharmacyProduct } from '../data/pharmacies';
import pastillenBg from '../assets/images/backgrounds/karte-pastillen-neu.png';
import saftBg from '../assets/images/backgrounds/karte-saft-neu-2.png';
import Container from './Container.astro';
import SliderControls from './SliderControls.astro';
import { productImages } from '../data/productImages';
import { iconSvg, type IconName } from '../data/icons';

interface Props {
  /** Hintergrund/zusätzliche Klassen der <section> (Standard: transparent, also weiß). */
  class?: string;
  /** Sichtbare H2 über den Karten (z. B. „Pastillen oder Saft?“); ohne Angabe nur
   *  eine Screenreader-Überschrift. */
  heading?: string;
  /** Optionale Anker-ID der Sektion (z. B. "produkte" auf der Startseite). */
  id?: string;
  /** Auswahl der gezeigten Präparate (Reihenfolge dieser Liste zählt).
   *  Ohne Angabe werden alle Karten gezeigt (Startseite, Produktseiten). */
  only?: PharmacyProduct[];
}

const { class: sectionClass = '', id, only, heading } = Astro.props;

// Produktnamen aus der zentralen Liste (pharmacies.ts).
const productName = Object.fromEntries(pharmacyProducts.map((p) => [p.key, p.name])) as Record<PharmacyProduct, string>;

interface ProductCard {
  /** Interner Produkt-Key (identisch zu src/data/pharmacies.ts). */
  key: PharmacyProduct;
  name: string;
  /** Optionale sichtbare Überschrift, falls kürzer als `name` (HTML erlaubt, z. B. <br>);
   *  `name` bleibt der volle Produktname für aria-label. */
  nameHtml?: string;
  /** Optionales Icon über dem Packshot (erscheint beim Hover): SVG aus icons.ts (Tropfen
   *  beim Saft, Pastille bei den Pastillen). */
  icon?: IconName;
  /** Kurzbeschreibung unter dem Produktnamen (Schriftbild wie der Einleitungstext). */
  description: string;
  href: string;
  /** Optionales Hintergrundbild der ganzen Karte (Hochformat, Studio-Look: Wand oben,
   *  heller Boden unten, auf dem der Text steht). */
  background?: ImageMetadata;
  /** Lage der Studiokante (Wand/Boden) und des Kontaktschattens im Hintergrundbild, je als
   *  Anteil der Bildhöhe (0–1). Das Bild wird so skaliert und verschoben, dass Kante und
   *  Schatten in allen Karten auf derselben Höhe liegen. Werte am Bild ausmessen. */
  backgroundEdgeAt?: number;
  backgroundShadowAt?: number;
}

// Kurztexte stellen den Unterschied der beiden Formen heraus (unterwegs / abends zu Hause).
// TODO (LARYLIN): Wortlaut fachlich freigeben lassen (HWG).
const products: ProductCard[] = [
  {
    key: 'pastillen',
    name: productName.pastillen,
    nameHtml: 'Husten-Stiller Pastillen',
    icon: 'pastille',
    description: 'Praktisch für unterwegs: einfach lutschen, ohne Wasser oder Löffel.',
    href: '/larylin-pastillen',
    background: pastillenBg,
    backgroundEdgeAt: 0.557,
    backgroundShadowAt: 0.615,
  },
  {
    key: 'saft',
    name: productName.saft,
    nameHtml: 'Husten-Stiller Saft',
    icon: 'drop',
    description: 'Für ruhigere Nächte: beruhigt den trockenen Reizhusten am Abend.',
    href: '/larylin-saft',
    background: saftBg,
    backgroundEdgeAt: 0.522,
    backgroundShadowAt: 0.565,
  },
];

// Auswahl in der Reihenfolge der `only`-Liste; ohne Prop alle Karten.
const visibleProducts = only
  ? only.map((k) => products.find((p) => p.key === k)).filter((p): p is ProductCard => Boolean(p))
  : products;
---

{visibleProducts.length > 0 && (
<section id={id} class={`py-16 md:py-20 px-6 scroll-mt-24 ${sectionClass}`}>
  <Container size="content">
    <div data-snap-slider>
      {/* Mit heading: sichtbare H2 links, Pfeile rechts (wie Bewertungen/Magazin). Ohne
          heading nur eine Screenreader-Überschrift: die Karten tragen h3, ohne h2 gäbe es
          einen Ebenensprung h1 → h3. */}
      {heading ? (
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 class="min-w-0 hyphens-auto">{heading}</h2>
          <SliderControls prevLabel="Vorherige Produkte" nextLabel="Weitere Produkte" />
        </div>
      ) : (
        <>
          <h2 class="sr-only">Unsere Produkte</h2>
          <SliderControls prevLabel="Vorherige Produkte" nextLabel="Weitere Produkte" class="justify-end mb-4" />
        </>
      )}

      {/* Track: scroll-snap; mobil ~85 % Kartenbreite, ab md 2, ab lg 3 Spalten. */}
      <div
        data-slider-track
        class="flex gap-6 slider-bleed overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 -mb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {visibleProducts.map((product) => (
          <div class="snap-start shrink-0 basis-[85%] md:basis-[calc((100%_-_1.5rem)/2)] lg:basis-[calc((100%_-_3rem)/3)]">
            {/* Karte mit zwei Zielen (kein <button> in einem <a>): eine unsichtbare
                Klickfläche über der ganzen Karte führt zur Produktseite; die Button-Zeile
                liegt darüber („Jetzt kaufen“ öffnet den Drawer, „Zum Produkt“ ist der
                eigentliche, per Tastatur erreichbare Link). */}
            <div class="product-card">
              {/* Klickfläche nur für die Maus/Touch: direktes Kind der Karte, damit sie
                  nicht in den per transform animierten Textblock rutscht (transform macht
                  ein Element zum Bezugsrahmen für absolut positionierte Kinder). */}
              <a href={product.href} class="product-card__overlay" tabindex="-1" aria-hidden="true"></a>
              {/* Hintergrundbild der ganzen Karte; liegt per z-index hinter dem Inhalt,
                  Ausrichtung über --bg-edge/--bg-shadow (CSS unten). */}
              {product.background && (
                <span
                  class="product-card__bg"
                  style={`--bg-edge: ${product.backgroundEdgeAt ?? 0.56}; --bg-shadow: ${product.backgroundShadowAt ?? 0.62}`}
                  aria-hidden="true"
                >
                  <Image
                    src={product.background}
                    alt=""
                    widths={[480, 800]}
                    sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 85vw"
                    loading="lazy"
                  />
                </span>
              )}

              {/* Optionales Produkt-Icon (Tropfen beim Saft, Pastille bei den Pastillen),
                  liegt über dem Packshot, sichtbar erst beim Hover. */}
              {product.icon && (
                <span class="product-card__icon" aria-hidden="true">
                  <Fragment set:html={iconSvg(product.icon, 'w-7 h-7')} />
                </span>
              )}

              <span class="product-card__media">
                <Image
                  src={productImages[product.key].cardFront.src}
                  alt={productImages[product.key].cardFront.alt}
                  width={640}
                  loading="lazy"
                  class="product-card__img product-card__img--front"
                />
                {/* Hover-Motiv rein dekorativ (nur per Opacity eingeblendet): leerer Alt-Text,
                    sonst lesen Screenreader die Karte doppelt vor. */}
                <Image
                  src={productImages[product.key].cardHover.src}
                  alt=""
                  width={640}
                  loading="lazy"
                  class="product-card__img product-card__img--hover"
                />
              </span>

              <span class="product-card__body">
                <h3 class="mb-3" set:html={product.nameHtml ?? product.name} />
                <p class="text-neutral-700 leading-relaxed">{product.description}</p>
              </span>

              {/* Kauf-CTA (rot, öffnet den Drawer mit vorgewähltem Produkt) und Link zur
                  Produktseite; beide liegen über der Klickfläche der Karte. */}
              <span class="product-card__cta-zone">
                <button
                  type="button"
                  class="product-card__buy"
                  data-open-pharmacy-drawer
                  data-drawer-product={product.key}
                  aria-label={`${product.name} jetzt kaufen`}
                >
                  Jetzt kaufen
                </button>
                <a href={product.href} class="product-card__cta" aria-label={`${product.name} – zum Produkt`}>
                  Zum Produkt
                </a>
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
)}

{/* Bewusst is:global mit product-card-Präfix: die Media Queries müssen
    Astro-Image-Ausgaben treffen, die Astros Scoping nicht erreicht. */}
<style is:global>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    text-align: left;
    text-decoration: none;
    /* Hellgraue Kartenfläche (Token in global.css), bewusst ohne Rahmen: die Fläche
       selbst trennt die Karte vom weißen Grund. */
    background: var(--color-surface);
    border-radius: var(--radius-card);
    /* Eigener Stapelkontext: das Hintergrundbild (z-index -1) liegt über der Kartenfläche,
       aber unter dem Inhalt; overflow schneidet es an den runden Ecken ab. */
    isolation: isolate;
    overflow: hidden;
  }

  /* Die Karte selbst reagiert nicht auf Hover (kein Rahmen, kein Anheben,
     kein Schatten) — nur der Inhalt: Bildwechsel, Text-Slide, CTA-Einblendung. */

  /* Klickfläche der ganzen Karte (Maus/Touch) über Bild und Text, unter der Button-Zeile
     (z-index 2). Per Tastatur ist „Zum Produkt“ das Ziel. */
  .product-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Icon oben rechts in einem Kreis im Logo-Gelb (schwarzes Icon); liegt über dem
     Packshot (kein eigener Platz nötig) und blendet erst beim Hover ein.
     Auf Touch dauerhaft sichtbar (siehe unten). */
  .product-card__icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--color-logo-yellow);
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }
  @media (hover: hover) {
    .product-card:hover .product-card__icon,
    .product-card:has(:focus-visible) .product-card__icon { opacity: 1; }
  }
  @media (hover: none) {
    .product-card__icon { opacity: 1; }
  }

  /* Packshot-Crossfade: alle PNGs auf 1200×1200-Leinwänden, Motive unten bündig
     (scripts/normalize-product-images.cjs) → gleiche Standhöhe; das Hover-Motiv
     fährt beim Einblenden leicht nach oben (--product-card-lift). */
  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    margin-bottom: 1rem;
  }
  /* Hintergrundbild der ganzen Karte. Kante (--bg-edge) und Kontaktschatten (--bg-shadow)
     des Motivs, je Anteil der Bildhöhe, landen in jeder Karte auf denselben Höhen, damit
     die Studiokante über nebeneinanderstehende Karten durchläuft:
     - Schatten bei --bg-shadow-y: Bildfeld-Kante (100cqw = Inhaltsbreite der Karte, das
       Bildfeld ist quadratisch) plus Padding oben (20px), minus 8px, weil
       die Packshots knapp über der Leinwandunterkante enden.
     - Kante 13cqw darüber (mitwachsend, damit es auf jeder Kartenbreite gleich wirkt).
     Daraus folgen Bildhöhe (Abstand / (Schatten − Kante)) und Versatz nach oben. 13cqw ist
     so gewählt, dass auch das Motiv mit dem kleinsten Abstand Kante/Schatten die Karte
     oben und unten noch füllt; overflow: hidden schneidet den Überstand ab. */
  .product-card { container-type: inline-size; }
  .product-card__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    --bg-shadow-y: calc(100cqw + 12px);
    --bg-h: calc(13cqw / (var(--bg-shadow) - var(--bg-edge)));
  }
  .product-card__bg img {
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--bg-h);
    top: calc(var(--bg-shadow-y) - var(--bg-shadow) * var(--bg-h));
    object-fit: cover;
  }
  .product-card__media .product-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 200ms ease, transform 250ms ease-out;
  }
  .product-card { --product-card-lift: -4%; }
  .product-card__img--hover { opacity: 0; }
  @media (hover: hover) {
    .product-card:hover .product-card__img--hover,
    .product-card:has(:focus-visible) .product-card__img--hover {
      opacity: 1;
      transform: translateY(var(--product-card-lift));
    }
    .product-card:hover .product-card__img--front,
    .product-card:has(:focus-visible) .product-card__img--front { opacity: 0; }
  }

  /* Touch: Zielzustand dauerhaft (kein Hover-Zwischenschritt), Tippen führt direkt zur Produktseite. */
  @media (hover: none) {
    .product-card__img--front { opacity: 0; }
    .product-card__img--hover { opacity: 1; transform: translateY(var(--product-card-lift)); }
  }

  /* margin-top:auto: Text sitzt am Kartenboden (Prospan-Prinzip: Packshot oben,
     Titel + Kurztext unten bündig), unabhängig von der Textlänge. */
  .product-card__body {
    display: block;
    margin-top: auto;
    transition: transform 250ms ease-out;
  }

  /* Button-Zeile: links der rote Kauf-CTA, daneben „Zum Produkt“. Die Zone reserviert ihre
     Höhe (--cta-zone) dauerhaft → kein Layout-Sprung, wenn die Buttons einfahren. */
  .product-card { --cta-zone: 3.25rem; }
  .product-card__cta-zone {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: var(--cta-zone);
    position: relative;
    z-index: 2;
    transition: opacity 250ms ease-out, transform 250ms ease-out;
  }

  /* Hover-Choreografie NUR auf Geräten mit echtem Hover: Text fährt um die Zonenhöhe hoch,
     die Buttons blenden von unten ein. Auf Touch dauerhaft sichtbar (kein Inhalt nur per
     Hover erreichbar). Per Tastatur über :has(:focus-visible), nicht :focus-within: nach
     einem Mausklick behält der Link den Fokus, und beim Zurück-Navigieren stellt der
     Browser die Seite samt Fokus wieder her; die Karte bliebe sonst aufgeklappt. */
  @media (hover: hover) {
    .product-card .product-card__body {
      transform: translateY(var(--cta-zone));
    }
    .product-card .product-card__cta-zone {
      opacity: 0;
      transform: translateY(12px);
    }
    .product-card:hover .product-card__body,
    .product-card:has(:focus-visible) .product-card__body {
      transform: translateY(0);
    }
    .product-card:hover .product-card__cta-zone,
    .product-card:has(:focus-visible) .product-card__cta-zone {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .product-card__buy,
  .product-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    transition: background-color 150ms ease, color 150ms ease;
  }
  /* Gefüllter roter Button = Kauf-Funktion (wie „In der Apotheke kaufen“ im Hero). */
  .product-card__buy {
    background: var(--color-red);
    color: var(--color-white);
    cursor: pointer;
  }
  .product-card__buy:hover {
    background: var(--color-red-dark);
  }
  .product-card__buy:focus-visible,
  .product-card__cta:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  /* Sekundär, gleiche Farben wie der Outline-Button im Hero („Pastillen oder Saft?“):
     weiß mit 2px Ink-Rand, beim Hover hellgrau (surface). Padding um die Rahmenbreite
     reduziert, damit beide Buttons gleich hoch sind. Hover greift auch über die übrige
     Kartenfläche (beides führt zur Produktseite). */
  .product-card__cta {
    padding: calc(0.5rem - 2px) calc(1.25rem - 2px);
    border: 2px solid var(--color-ink);
    background: var(--color-white);
    color: var(--color-ink);
    text-decoration: none;
  }
  .product-card__cta:hover,
  .product-card:has(.product-card__overlay:hover) .product-card__cta {
    background: var(--color-surface);
  }
</style>

<script>
  import { initSnapSliders } from '../scripts/snapSlider';
  initSnapSliders();
</script>

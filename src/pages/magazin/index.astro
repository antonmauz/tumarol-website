---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbSection from '../../components/BreadcrumbSection.astro';
import TrustBanner from '../../components/TrustBanner.astro';
import KamillenLebenszyklus from '../../components/KamillenLebenszyklus.astro';
import ProductHighlight from '../../components/ProductHighlight.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import Container from '../../components/Container.astro';
import { produktSources } from '../../data/produktSources';
import { hinweise } from '../../data/hinweise';

// HINWEIS (07.09.2026): Keine Magazin-Artikel auf dieser Seite (Entscheidung
// Anton) — die frühere Content-Collection „magazin“ wurde entfernt. Alle
// Artikel liegen unter Wissenswertes (/wissenswertes).

// Sektionsname (01.09.2026): „Unser Kamillenanbau" — der URL-Slug /magazin
// bleibt Arbeitsname (final vor der Indexierung festlegen).
const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Unser Kamillenanbau' },
];
---

<Layout
  title="Unser Kamillenanbau"
  description="Unser Kamillenanbau: eigene Spezialsorten aus Thüringen, kontrolliert-integrierter Anbau, Extraktion und Abfüllung in Esslingen – vom Feld in die Flasche."
>

  {/* ─── NAVIGATION BREADCRUMBS ──────────────────────────────────────── */}
  <BreadcrumbSection items={breadcrumbItems} />

  {/* Oben bewusst knapp: Breadcrumbs und H1 bilden einen zusammenhängenden Seitenkopf. */}
  {/* ─── HERO / INTRO SECTION ────────────────────────────────────────── */}
  <section class="pt-4 pb-16 md:pt-6 md:pb-20 px-6">
    <Container size="content">
      <h1 class="mb-6">
        Unser Kamillenanbau
      </h1>
      {/* Einleitung unter der H1 (Anton, 07.09.2026) in Lead-Größe (text-xl wie die anderen
          Seiten); die Details zu KIA und Pyrrolizidin-Alkaloiden stehen im Slider darunter. */}
      <div class="max-w-3xl space-y-4">
        <p class="text-xl text-neutral-600 leading-relaxed">
          Wir arbeiten ausschließlich mit unseren eigenen, geschützten Spezialsorten,
          die im Kontrolliert-Integrierten Anbau (KIA) kultiviert werden. Angebaut
          wird sie auf mehreren hundert Hektar in Thüringen – einer der
          traditionsreichsten Regionen für den Arzneipflanzenanbau in Deutschland.
        </p>
        <p class="text-xl text-neutral-600 leading-relaxed">
          Saatgutselektion, Anbau, Ernte und Extraktion in Esslingen liegen
          vollständig unter unserer Kontrolle. Die wirksamkeitsbestimmenden
          Komponenten, ätherisches Öl mit (–)-α-Bisabolol und Chamazulen sowie
          Flavonoide wie Apigenin, werden chargenweise quantifiziert.
          Der Extrakt für unsere KAMILLIN®-Präparate wird in
          hoher Konzentration gewonnen.
        </p>
      </div>
    </Container>
  </section>

  {/* ─── LEBENSZYKLUS: fünf Stationen vom Anbau in Thüringen bis zur Abfüllung in Esslingen (KamillenLebenszyklus.astro). ──────────────────────── */}
  <KamillenLebenszyklus id="vom-feld-in-die-flasche" />

  {/* ─── VERTRAUEN-BANNER ──────────────────────────────────────────── */}
  <TrustBanner />

  {/* ─── PRODUKT-HIGHLIGHT (CTA) ─────────────────────────────────────── */}
  <ProductHighlight />

  {/* ─── QUELLEN & HINWEISE: Produktquellen ([1] …) + Erläuterungen * / ** (GACP/GMP aus dem Lebenszyklus-Slider) ───────────────────────────── */}
  <SourcesSection heading="Quellen & Hinweise" items={[...produktSources, ...hinweise]} />

</Layout>

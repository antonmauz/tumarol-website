---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSection from '../components/BreadcrumbSection.astro';
import ProductHero from '../components/ProductHero.astro';
import ReviewSlider from '../components/ReviewSlider.astro';
import ApplicationSlider from '../components/ApplicationSlider.astro';
import Faq from '../components/sections/Faq.astro';
import DownloadsSection from '../components/DownloadsSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import ArticleSlider from '../components/ArticleSlider.astro';
import TrustBanner from '../components/TrustBanner.astro';
import ProductSchema from '../components/ProductSchema.astro';
import { faqsFor } from '../data/faqs';
import { produktSources } from '../data/produktSources';

// Produktseite Larylin® Husten-Stiller Pastillen (Arzneimittel). Aufbau: Kopf → Bewertungen → Anwendung → FAQ →
// Downloads → Wissenswertes → Hersteller → Quellen; Kauf über den Apotheken-Drawer.
// Gerüst: Bewertungen, Anwendung, FAQ und Downloads rendern erst, wenn ihre Daten in
// src/data/ eingetragen sind (TODO (LARYLIN)). Product-JSON-LD: ProductSchema.astro.

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Larylin® Husten-Stiller Pastillen' },
];

// Kernpunkte des Seitenkopfs. TODO (LARYLIN): Wortlaut fachlich freigeben lassen (HWG).
const heroBullets = [
  'Hemmt den Hustenreiz direkt in der Lunge',
  'Ohne Konservierungsstoffe',
  'Hemmt Reiz- und Krampfhusten',
  'Ideal für unterwegs',
];

// Eine Quelle für Meta-Description und Product-JSON-LD.
const description =
  'Larylin® Husten-Stiller Pastillen: Lutschpastillen mit dem Wirkstoff Dropropizin. Packungsgröße, PZN und Kauf in der Apotheke vor Ort oder online.';
---

<Layout
  title="Larylin® Husten-Stiller Pastillen: Lutschpastillen mit Dropropizin"
  titleSuffix={false}
  description={description}
  pharmacyProduct="pastillen"
  stickyBuy
>

  <ProductSchema product="pastillen" name="Larylin® Husten-Stiller Pastillen" description={description} category="Arzneimittel" />

  {/* ─── NAVIGATION BREADCRUMBS ──────────────────────────────────────── */}
  <BreadcrumbSection items={breadcrumbItems} />

  {/* ─── HERO / PRODUCT INTRO ────────────────────────────────────────── */}
  <ProductHero product="pastillen" name="Larylin® Husten-Stiller Pastillen" bullets={heroBullets} />

  {/* ─── PRODUKTBEWERTUNGEN dieses Präparats (src/data/reviews/pastillen.ts) ── */}
  <ReviewSlider product="pastillen" />

  {/* ─── ANWENDUNG & DOSIERUNG (src/data/applications.ts) ───────────── */}
  <ApplicationSlider id="anwendung" product="pastillen" />

  {/* ─── VERTRAUEN-BANNER ──────────────────────────────────────────── */}
  <TrustBanner />

  {/* ─── FAQ (src/data/faqs.ts) ─────────────────────────────────────── */}
  <Faq id="faqs" items={faqsFor('pastillen')} schema />

  {/* ─── DOWNLOADS (src/data/downloads.ts, Dateien in public/downloads/) ─ */}
  <DownloadsSection id="downloads" product="pastillen" />

  {/* ─── ARTIKEL: Wissenswertes-Kacheln (wie Startseite) ─────────────── */}
  <ArticleSlider heading="Wissenswertes rund um Husten" mark="Husten" />

  {/* ─── QUELLEN ─────────────────────────────────────────────────────── */}
  <SourcesSection heading="Quellen & Hinweise" items={produktSources} />

</Layout>

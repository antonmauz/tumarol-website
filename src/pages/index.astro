---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { produktSources } from '../data/produktSources';
import RobugenBanner from '../components/RobugenBanner.astro';
import ReviewSlider from '../components/ReviewSlider.astro';
import ArticleSlider from '../components/ArticleSlider.astro';
import Container from '../components/Container.astro';
import { hinweise } from '../data/hinweise';
import { accentAt } from '../data/brand';

// Fakten-Leiste unter dem Hero, je mit kurzem Farbbalken (Folge Gelb/Orange/Rot).
const facts = ['Reiz- und Krampfhusten', 'Ab 12 Jahren', 'Zwei Formen'];

// „Trocken oder mit Schleim?“: drei Zeilen mit Farbbalken.
// TODO Inhalte: Texte sind Platzhalter bis zur fachlichen Freigabe.
const coughRows = [
  {
    title: 'Trockener Reizhusten',
    text: 'Der Hals kratzt, der Husten kommt immer wieder, aber es löst sich kein Schleim. Hier setzt ein Husten-Stiller an.',
  },
  {
    title: 'Husten mit Schleim',
    text: 'Löst sich Schleim, soll er abgehustet werden. Ein Husten-Stiller ist dann nicht das Mittel der Wahl.',
  },
  {
    title: 'Wann zum Arzt?',
    text: 'Bei Fieber, Atemnot, Blut im Auswurf oder Husten, der länger als zwei Wochen anhält, ärztlichen Rat einholen.',
  },
];
---

<Layout
  title="KAMILLIN® von ROBUGEN – Kamille aus Thüringen"
  titleSuffix={false}
  description="KAMILLIN® von ROBUGEN: Kamillenblüten-Auszug aus eigenem Anbau in Thüringen, hergestellt in Esslingen. Die Präparate, ihre Anwendung und Wissenswertes zur Kamille."
>

  {/* ─── 1. HERO: links Text + Buttons, rechts Packshots ────────────────── */}
  <section class="px-6 pt-10 pb-16 md:pt-16 md:pb-20">
    <Container size="content" class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-wider">
          <span class="accent-bar bg-yellow" aria-hidden="true"></span>
          Husten-Stiller mit Dropropizin
        </p>
        <h1 class="mb-6">Bei trockenem <span class="mark">Reizhusten</span>.</h1>
        {/* TODO Inhalte: Platzhaltertext bis zur fachlichen Freigabe. */}
        <p class="mb-8 max-w-xl text-lg text-neutral-700">
          Larylin® Husten-Stiller mit dem Wirkstoff Dropropizin – zur Wahl als Pastillen
          oder als Saft.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button openDrawer>In der Apotheke kaufen</Button>
          <Button href="#produkte" variant="outline">Pastillen oder Saft?</Button>
        </div>
      </div>

      {/* Packshots: Platzhalter, bis die Bilder unter src/assets/images/products/ liegen. */}
      <div class="flex aspect-[4/3] items-center justify-center rounded-card bg-surface text-sm font-semibold text-neutral-500">
        Packshots folgen
      </div>
    </Container>
  </section>

  {/* ─── 2. FAKTEN-LEISTE ───────────────────────────────────────────────── */}
  <section class="px-6 border-y border-divider" aria-label="Auf einen Blick">
    <Container size="content">
      <ul class="grid divide-y divide-divider md:grid-cols-3 md:divide-y-0 md:divide-x">
        {facts.map((fact, i) => (
          <li class="flex items-center gap-4 py-5 md:px-6 md:first:pl-0">
            <span class={`accent-bar ${accentAt(i)}`} aria-hidden="true"></span>
            <span class="text-lg font-extrabold tracking-tight">{fact}</span>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  {/* ─── 3. PASTILLEN ODER SAFT? (Produktkarten hellgrau auf Weiß) ──────── */}
  <ProductHighlight id="produkte" heading="Pastillen oder Saft?" />

  {/* ─── 4. PRODUKTBEWERTUNGEN (Sektion hellgrau, Karten weiß) ──────────── */}
  <ReviewSlider class="bg-surface" />

  {/* ─── 5. TROCKEN ODER MIT SCHLEIM? ───────────────────────────────────── */}
  <section class="px-6 py-16 md:py-20">
    <Container size="content" class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-14">
      <h2>Trocken oder mit <span class="mark">Schleim</span>?</h2>
      <ul class="border-t border-divider">
        {coughRows.map((row, i) => (
          <li class="grid gap-2 border-b border-divider py-6 md:grid-cols-[14rem_1fr] md:gap-8">
            <h3 class="flex items-center gap-3 text-lg">
              <span class={`accent-bar ${accentAt(i)}`} aria-hidden="true"></span>
              {row.title}
            </h3>
            <p class="text-neutral-700">{row.text}</p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  {/* ─── 6. MAGAZIN (Karten hellgrau, Farbbalken Gelb/Orange/Rot) ───────── */}
  <ArticleSlider heading="Wissenswertes rund um Husten" class="border-t border-divider" />

  {/* ─── HERSTELLER: Robugen-Vertrauensmodul ────────────────────────────── */}
  <RobugenBanner class="bg-surface" />

  {/* ─── QUELLEN & HINWEISE ─────────────────────────────────────────────── */}
  <SourcesSection heading="Quellen & Hinweise" items={[...produktSources, ...hinweise]} />

</Layout>

---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { produktSources } from '../data/produktSources';
import ReviewSlider from '../components/ReviewSlider.astro';
import ArticleSlider from '../components/ArticleSlider.astro';
import WirkungsweiseSection from '../components/WirkungsweiseSection.astro';
import TrustBanner from '../components/TrustBanner.astro';
import Container from '../components/Container.astro';
import Mascot from '../components/Mascot.astro';
import PackshotGroup from '../components/PackshotGroup.astro';
---

<Layout
  topBar
  stickyBuy
  title="Larylin® Husten-Stiller – bei trockenem Reizhusten"
  titleSuffix={false}
  description="Larylin® Husten-Stiller von ROBUGEN mit dem Wirkstoff Dropropizin, als Pastillen oder Saft. Wo Sie Larylin® kaufen können und Wissenswertes rund um Husten."
>

  {/* ─── 1. HERO: gelbes Markenband (Mockup B), Text links, Koala rechts ─── */}
  {/* Der Koala steht in einer eigenen Spalte auf der Unterkante des Bands (Bild ist unten
      bündig getrimmt) und überlappt weder Text noch Buttons; mobil steht er unter den
      Buttons. HWG: keine Sprechblase, nicht neben einem Kinderbalsam-CTA. */}
  <section data-sticky-buy-trigger class="bg-yellow">
    <Container size="content" class="grid items-end gap-x-10 px-6 pt-10 lg:grid-cols-[1fr_auto] lg:pt-14">
      <div class="lg:self-center lg:pb-14">
        <h1 class="hero-title mb-8 lg:mb-6">Larylin<sup class="hero-reg">®</sup> gegen <span class="mark">Reizhusten</span></h1>

        <PackshotGroup class="hero-packs" sizes="(min-width: 1024px) 260px, 220px" loading="eager" />

        <div class="flex flex-col gap-3 sm:flex-row">
          <Button openDrawer>Jetzt kaufen</Button>
          <Button href="#produkte" variant="outline">Pastillen oder Saft?</Button>
        </div>
      </div>

      <Mascot
        pose="stehend"
        sizes="(min-width: 1280px) 400px, (min-width: 1024px) 340px, 200px"
        loading="eager"
        fetchpriority="high"
        class="mx-auto mt-10 w-[200px] lg:mt-0 lg:w-[340px] xl:w-[400px]"
      />
    </Container>
  </section>

  {/* ─── 2. TEXT: TROCKENER REIZHUSTEN? ─────────────────────────────────── */}
  {/* TODO (LARYLIN): Wortlaut fachlich freigeben lassen (HWG: „zuverlässig“, „gute
      Verträglichkeit“ und Wirkmechanismus brauchen einen Beleg). */}
  <section class="px-6 pt-12 md:pt-16 border-t border-divider">
    <Container size="content" class="text-center">
      <h2 class="mb-4">Trockener Reizhusten?</h2>
      <p class="mx-auto max-w-3xl text-lg text-neutral-700 leading-relaxed">
        Trockener Reizhusten kann quälend sein, tagsüber und erst recht nachts.
        Larylin® Husten-Stiller mit dem Wirkstoff Dropropizin ist bei Reiz- und
        Krampfhusten zugelassen, als Saft oder als Pastillen. Dropropizin wirkt vor allem
        dort, wo der Hustenreiz entsteht: Es schwächt die Nervensignale aus der Lunge ab,
        die den Hustenreflex auslösen.
      </p>
    </Container>
  </section>

  {/* ─── 3. PASTILLEN ODER SAFT? (Produktkarten hellgrau auf Weiß) ──────── */}
  <ProductHighlight id="produkte" heading="Pastillen oder Saft?" />

  {/* ─── 4. PRODUKTBEWERTUNGEN ──────────────────────────────────────────── */}
  <ReviewSlider />

  {/* ─── 5. WIRKUNGSWEISE: Figur mit Pfeilen auf Gehirn, Atemwege, Lunge ─── */}
  <WirkungsweiseSection />

  {/* ─── VERTRAUEN-BANNER: Packshots + vier Punkte auf Studio-Hintergrund ─── */}
  <TrustBanner />

  {/* ─── 6. MAGAZIN (Karten hellgrau, Farbbalken Gelb/Orange/Rot) ───────── */}
  <ArticleSlider heading="Wissenswertes rund um Husten" mark="Husten" />

  {/* ─── QUELLEN (erscheint erst, wenn produktSources belegt ist) ───────── */}
  <SourcesSection items={produktSources} />

</Layout>

<style>
  /* Hero-H1 größer als die globale H1 (eine Zeile pro Wortgruppe auf Desktop). */
  .hero-title {
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    line-height: 0.98;
  }
  /* Gelber Unterstrich verschwindet auf dem gelben Band: im Hero in Tumarol-Grün
     (reine Dekoration, kein Text). */
  .hero-title :global(.mark) {
    text-decoration-color: var(--color-green);
  }
  /* PackshotGroup im Hero (global, weil die Klasse am Komponenten-Root sitzt): im Fluss
     zwischen H1 und Buttons. */
  :global(.hero-packs) {
    width: 220px;
    margin-bottom: 2rem;
  }
  @media (min-width: 64rem) {
    :global(.hero-packs) { width: 260px; }
  }
  .hero-reg {
    font-size: 0.35em;
    vertical-align: super;
    line-height: 0;
    font-weight: 600;
  }
</style>

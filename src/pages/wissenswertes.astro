---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BreadcrumbSection from '../components/BreadcrumbSection.astro';
import ArticleTile from '../components/ArticleTile.astro';
import TrustBanner from '../components/TrustBanner.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import SourcesSection from '../components/SourcesSection.astro';
import Container from '../components/Container.astro';
import { categoryClusters, ratgeberArticleUrl } from '../data/categories';
import { readingTimeLabel } from '../data/readingTime';
import { produktSources } from '../data/produktSources';
import { sortRatgeberArticles } from '../utils/articleSort';

// Redaktionslinie (01.09.2026): „Wissenswertes“ ist ein lockerer Ratgeber, keine
// Fachartikel; Vorschau als Bild-Kacheln (ArticleTile). Reihenfolge zentral in
// utils/articleSort.ts (Cluster-Rang, dann alphabetisch).
const artikel = sortRatgeberArticles(await getCollection('ratgeber'));

// Cluster-Reihenfolge zentral aus categoryClusters; leere Cluster werden nicht gerendert.
const cluster = categoryClusters.map((c) => ({
  ...c,
  artikel: artikel.filter((entry) => entry.data.category === c.category),
}));

// Sektionsname (01.09.2026): „Wissenswertes" — URL-Slug /wissenswertes
// festgelegt (02.09.2026).
const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Wissenswertes' },
];
---

<Layout
  title="Wissenswertes"
  description="Wissenswertes zu Bauch, Mund und Haut: verständliche Ratgeber zu typischen Beschwerden, was im Alltag hilft und wann ein Arztbesuch ratsam ist."
>

  {/* ─── NAVIGATION BREADCRUMBS ──────────────────────────────────────── */}
  <BreadcrumbSection items={breadcrumbItems} />

  {/* Oben bewusst knapp: Breadcrumbs und H1 bilden einen zusammenhängenden Seitenkopf. */}
  {/* ─── HERO / INTRO SECTION ────────────────────────────────────────── */}
  <section class="pt-4 pb-12 md:pt-6 md:pb-16 px-6">
    <Container size="content">
      <h1 class="mb-6">
        Wissenswertes
      </h1>
      {/* Produktneutrale Einleitung (07.09.2026). */}
      <p class="text-xl text-neutral-600 leading-relaxed max-w-3xl">
        Verständliche Antworten rund um Bauch, Mund und Haut: Was hinter typischen
        Beschwerden steckt, was im Alltag hilft und wann ein Arztbesuch ratsam ist –
        sortiert nach den drei Themen Gutes Bauchgefühl, Gesunder Mund und Heile Haut.
      </p>
    </Container>
  </section>

  {/* ─── ARTIKEL-GRID (nach Themen-Cluster gruppiert) ────────────────── */}
  <section class="py-16 md:py-20 px-6">
    <Container size="content">
      <div class="space-y-16">
        {cluster.filter((c) => c.artikel.length > 0).map((c) => (
          <div id={c.category} class="scroll-mt-24">
            <h2 class="mb-8">{c.heading}</h2>
            {/* Mobil Peek-Slider wie die Produktkarten (basis-[85%], slider-bleed bis zum
                Bildschirmrand), ab md 2er-/3er-Grid; Flex-/Snap-Klassen sind im Grid
                wirkungslos, nur der Randausgleich wird per md:mx-0/px-0 aufgehoben. */}
            <div class="flex overflow-x-auto snap-x snap-mandatory slider-bleed md:grid md:grid-cols-2 lg:grid-cols-3 md:overflow-visible md:mx-0 md:px-0 md:scroll-px-0 gap-6 pb-2 -mb-2 md:pb-0 md:mb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {c.artikel.map((entry) => (
                <div class="snap-start shrink-0 basis-[85%]">
                  <ArticleTile
                    href={ratgeberArticleUrl(entry.data.category, entry.id)}
                    title={entry.data.h1}
                    image={entry.data.headerImage}
                    imageAlt={entry.data.headerImageAlt ?? entry.data.title}
                    readingTime={readingTimeLabel(entry.body ?? '')}
                  />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* ─── VERTRAUEN-BANNER ──────────────────────────────────────────── */}
  <TrustBanner />

  {/* ─── PRODUKT-HIGHLIGHT (CTA) ─────────────────────────────────────── */}
  <ProductHighlight />

  {/* ─── QUELLEN (Belege zu den CTA-Kernaussagen) ────────────────────── */}
  <SourcesSection items={produktSources} />

</Layout>

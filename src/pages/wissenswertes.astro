---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BreadcrumbSection from '../components/BreadcrumbSection.astro';
import ArticleTile from '../components/ArticleTile.astro';
import ArticleFeature from '../components/ArticleFeature.astro';
import ArticleListItem from '../components/ArticleListItem.astro';
import TrustBanner from '../components/TrustBanner.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import SourcesSection from '../components/SourcesSection.astro';
import Container from '../components/Container.astro';
import { categoryClusters, ratgeberArticleUrl } from '../data/categories';
import { readingTimeLabel } from '../data/readingTime';
import { produktSources } from '../data/produktSources';
import { sortRatgeberArticles } from '../utils/articleSort';

// Redaktionslinie (01.09.2026): „Wissenswertes“ ist ein lockerer Ratgeber, keine
// Fachartikel; Vorschau als Bild-Kacheln (ArticleTile). Reihenfolge zentral in
// utils/articleSort.ts (Cluster-Rang, dann alphabetisch).
const artikel = sortRatgeberArticles(await getCollection('ratgeber'));

// Cluster-Reihenfolge zentral aus categoryClusters; leere Cluster werden nicht gerendert.
const cluster = categoryClusters.map((c) => ({
  ...c,
  artikel: artikel.filter((entry) => entry.data.category === c.category),
}));
const visibleCluster = cluster.filter((c) => c.artikel.length > 0);

// Sektionsname (01.09.2026): „Wissenswertes" — URL-Slug /wissenswertes
// festgelegt (02.09.2026).
const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Wissenswertes' },
];
---

<Layout
  title="Wissenswertes"
  description="Wissenswertes rund um Husten: verständliche Ratgeber zu Reizhusten und Erkältung, was im Alltag hilft und wann ein Arztbesuch ratsam ist."
>

  {/* ─── NAVIGATION BREADCRUMBS ──────────────────────────────────────── */}
  <BreadcrumbSection items={breadcrumbItems} />

  {/* Kein sichtbarer Seitenkopf: die Breadcrumbs führen direkt zu den Themen. Die H1
      bleibt für Screenreader und Suchmaschinen erhalten (sr-only). */}
  <h1 class="sr-only">Wissenswertes</h1>

  {/* ─── ARTIKEL (nach Themen-Cluster, Layouts im Wechsel) ─────────────── */}
  {/* Nach chase.de/blog: Cluster abwechselnd als
      · „Aufmacher“ (weiß): große Karte mit Kurztext + Liste kompakter Einträge daneben,
        die Seite des Aufmachers wechselt bei jedem Aufmacher-Cluster;
      · „Kacheln“ (hellgraue Fläche über die volle Breite): weiße Karten im 3er-Grid.
      Der Rhythmus aus Größen, Flächen und Seiten verhindert den Einheitslook. */}
  {visibleCluster.map((c, i) => {
    const tiles = i % 2 === 1;
    const featureRight = i % 4 === 2;
    const [lead, ...rest] = c.artikel;
    return (
      <section id={c.category} class:list={['scroll-mt-24 px-6 py-14 md:py-20', tiles && 'bg-surface']}>
        <Container size="content">
          <h2 class="mb-8 md:mb-10">
            {c.mark && c.heading.includes(c.mark) ? (
              <>{c.heading.slice(0, c.heading.indexOf(c.mark))}<span class="mark">{c.mark}</span>{c.heading.slice(c.heading.indexOf(c.mark) + c.mark.length)}</>
            ) : c.heading}
          </h2>

          {tiles ? (
            /* Mobil Peek-Slider (basis-[85%], slider-bleed bis zum Bildschirmrand), ab md
               2er-/3er-Grid; Flex-/Snap-Klassen sind im Grid wirkungslos. */
            <div class="flex overflow-x-auto snap-x snap-mandatory slider-bleed md:grid md:grid-cols-2 lg:grid-cols-3 md:overflow-visible md:mx-0 md:px-0 md:scroll-px-0 gap-6 pb-2 -mb-2 md:pb-0 md:mb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {c.artikel.map((entry) => (
                <div class="snap-start shrink-0 basis-[85%]">
                  <ArticleTile
                    href={ratgeberArticleUrl(entry.data.category, entry.id)}
                    title={entry.data.h1}
                    image={entry.data.headerImage}
                    imageAlt={entry.data.headerImageAlt ?? entry.data.title}
                    readingTime={readingTimeLabel(entry.body ?? '')}
                    surface="white"
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
              <div class:list={[featureRight && 'lg:order-2']}>
                <ArticleFeature
                  href={ratgeberArticleUrl(lead.data.category, lead.id)}
                  title={lead.data.h1}
                  excerpt={lead.data.metaDescription}
                  image={lead.data.headerImage}
                  imageAlt={lead.data.headerImageAlt}
                  readingTime={readingTimeLabel(lead.body ?? '')}
                />
              </div>
              {rest.length > 0 && (
                <ul class="flex flex-col gap-6">
                  {rest.map((entry) => (
                    <li>
                      <ArticleListItem
                        href={ratgeberArticleUrl(entry.data.category, entry.id)}
                        title={entry.data.h1}
                        image={entry.data.headerImage}
                        imageAlt={entry.data.headerImageAlt}
                        readingTime={readingTimeLabel(entry.body ?? '')}
                      />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </Container>
      </section>
    );
  })}

  {/* ─── VERTRAUEN-BANNER ──────────────────────────────────────────── */}
  <TrustBanner />

  {/* ─── PRODUKT-HIGHLIGHT (CTA) ─────────────────────────────────────── */}
  <ProductHighlight />

  {/* ─── QUELLEN (Belege zu den CTA-Kernaussagen) ────────────────────── */}
  <SourcesSection items={produktSources} />

</Layout>

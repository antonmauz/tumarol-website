---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSection from '../components/BreadcrumbSection.astro';
import ProductHero from '../components/ProductHero.astro';
import ReviewSlider from '../components/ReviewSlider.astro';
import ApplicationSlider from '../components/ApplicationSlider.astro';
import KamillenanbauCta from '../components/KamillenanbauCta.astro';
import Faq from '../components/sections/Faq.astro';
import DownloadsSection from '../components/DownloadsSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import TrustBanner from '../components/TrustBanner.astro';
import ArticleSlider from '../components/ArticleSlider.astro';
import RobugenBanner from '../components/RobugenBanner.astro';
import ProductSchema from '../components/ProductSchema.astro';
import { faqsFor } from '../data/faqs';
import { produktSources } from '../data/produktSources';
import { zusammensetzungSatz } from '../data/pflichtangaben';

// Produktseite KAMILLIN® EXTERN ROBUGEN (Arzneimittel), Slug festgelegt 01.09.2026. Aufbau:
// Kopf → Bewertungen → Anwendung → Wirkstoff → FAQ → Downloads → Vertrauen → Wissenswertes →
// Hersteller → Quellen; Kauf über den Apotheken-Drawer. Product-JSON-LD: ProductSchema.astro.

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'KAMILLIN® EXTERN ROBUGEN' },
];

// Kernpunkte des Seitenkopfs (Wortlaut Anton, 07.09.2026).
const heroBullets = [
  'DEV (1:2,0–2,8) Konzentrierter Kamillenblüten-Auszug',
  'Entzündungshemmend und wundheilend',
  'Für jedes Alter ab 4 Wochen',
  'Kamille aus Thüringen',
];

// Eine Quelle für Meta-Description und Product-JSON-LD.
const description =
  'KAMILLIN® EXTERN ROBUGEN: pflanzliches Arzneimittel mit Kamillenblüten-Auszug zur äußerlichen Anwendung in Umschlägen, Spülungen und Bädern. Dosierung, FAQ und Downloads.';
---

<Layout
  title="KAMILLIN® EXTERN ROBUGEN: Anwendung, Bäder & Spülungen"
  titleSuffix={false}
  description={description}
  pharmacyProduct="extern"
>

  <ProductSchema product="extern" name="KAMILLIN® EXTERN ROBUGEN" description={description} category="Pflanzliches Arzneimittel" />

  {/* ─── NAVIGATION BREADCRUMBS ──────────────────────────────────────── */}
  <BreadcrumbSection items={breadcrumbItems} />

  {/* Oben bewusst knapp: Breadcrumbs und Seitenkopf bilden eine Einheit. */}
  {/* ─── HERO / PRODUCT INTRO ────────────────────────────────────────── */}
  <ProductHero product="extern" name="KAMILLIN® EXTERN ROBUGEN" bullets={heroBullets} />

  {/* ─── PRODUKTBEWERTUNGEN dieses Präparats ────────────────────────── */}
  <ReviewSlider product="extern" />

  {/* ─── ANWENDUNG & DOSIERUNG (Kacheln, src/data/applications.ts) ──── */}
  <ApplicationSlider id="anwendung" product="extern" />

  {/* ─── WIRKSTOFF: Kamillen-CTA mit dem Zusammensetzungssatz aus den Pflichtangaben ─── */}
  <KamillenanbauCta id="wirkstoff" heading="Wirkstoff Kamillenblüten-Auszug" intro={zusammensetzungSatz('extern')} />

  {/* ─── FAQ (src/data/faqs.ts) ─────────────────────────────────────── */}
  <Faq id="faqs" items={faqsFor('extern')} schema />

  {/* ─── DOWNLOADS (src/data/downloads.ts, Dateien in public/downloads/) ─ */}
  <DownloadsSection id="downloads" product="extern" />

  {/* ─── VERTRAUEN ───────────────────────────────────────────────────── */}
  <TrustBanner />

  {/* ─── ARTIKEL: Wissenswertes-Kacheln (wie Startseite) ─────────────── */}
  <ArticleSlider heading="Mehr Informationen" />

  {/* ─── HERSTELLER ───────────────────────────────────────────────────── */}
  <RobugenBanner />

  {/* ─── QUELLEN ─────────────────────────────────────────────────────── */}
  <SourcesSection heading="Quellen & Hinweise" items={produktSources} />

</Layout>
